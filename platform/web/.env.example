# ---------------------------------------------------------------------------
# Base URL of the Core API (REST /v1, docs/api.md). In dev the Vite proxy
# forwards /v1 to the local Core API, so the default works with no backend URL
# hardcoded. Set it to the gateway origin for non-proxied builds.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/v1

# Dev only: where the Vite proxy forwards /v1 requests (Core API location).
# VITE_API_PROXY=http://localhost:8080
